# ---------------------------------------------------------------------------
# SwissHub Sponsoring – Konfiguration
#
# Kopieren Sie diese Datei nach `.env` und passen Sie die Werte an.
# Committen Sie niemals eine echte `.env` mit Produktionswerten.
# ---------------------------------------------------------------------------

# --- Datenbank -------------------------------------------------------------
# Lokale Entwicklung (docker compose up -d):
DATABASE_URL="postgresql://swisshub:swisshub@localhost:5432/swisshub?schema=public"

# Im Produktivbetrieb mit docker-compose.prod.yml wird DATABASE_URL automatisch
# aus den folgenden drei Werten zusammengesetzt:
POSTGRES_USER="swisshub"
POSTGRES_PASSWORD="hier-ein-langes-zufaelliges-passwort-eintragen"
POSTGRES_DB="swisshub"

# --- Sicherheit ------------------------------------------------------------
# Schlüssel für Sessions und Seiten-Passwortschutz.
# Erzeugen mit:  openssl rand -base64 48
AUTH_SECRET="bitte-ersetzen-openssl-rand-base64-48"

# --- Anwendung -------------------------------------------------------------
# Vollständige öffentliche Adresse ohne abschliessenden Schrägstrich.
# Wird für Links, Sitemap, OpenGraph und den Twitch-Embed verwendet.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Port, auf dem der Container auf dem Host lauscht (nur Produktion).
APP_PORT="3000"

# --- Uploads ---------------------------------------------------------------
# Verzeichnis für hochgeladene Dateien. Im Container ein persistentes Volume.
UPLOAD_DIR="./uploads"

# Maximale Dateigrösse pro Upload in Bytes (Standard: 10 MB).
MAX_UPLOAD_SIZE="10485760"

# --- Erstes Adminkonto -----------------------------------------------------
# Wird beim ersten Start automatisch angelegt, falls noch kein Konto existiert.
# Ändern Sie das Passwort direkt nach der ersten Anmeldung und entfernen Sie
# ADMIN_INITIAL_PASSWORD danach aus der .env.
# Alternativ: npm run admin:create -- --email admin@swisshub.gg --name "Admin"
ADMIN_EMAIL="admin@swisshub.gg"
ADMIN_INITIAL_PASSWORD="bitte-aendern-Passwort2026"

# --- Optionale Feinjustierung ---------------------------------------------
# Gültigkeitsdauer einer Admin-Session in Sekunden (Standard: 12 Stunden).
SESSION_MAX_AGE="43200"

# Gültigkeitsdauer des Zugangs zu einer passwortgeschützten Sponsorenseite
# in Sekunden (Standard: 14 Tage).
PAGE_PASSWORD_MAX_AGE="1209600"

# Login-Rate-Limit: Versuche pro Zeitfenster und Fensterlänge in Sekunden.
LOGIN_MAX_ATTEMPTS="8"
LOGIN_WINDOW_SECONDS="900"

# Auf "true" setzen, um das automatische Seeding beim Start zu überspringen.
SKIP_BOOTSTRAP="false"

# --- PDF-Export ------------------------------------------------------------
# Basis-URL, die der Headless-Browser intern lädt. Standard ist Loopback im
# Container; nur ändern, wenn die App hinter einem anderen internen Port läuft.
PDF_INTERNAL_BASE_URL="http://127.0.0.1:3000"

# Wie viele PDFs gleichzeitig erzeugt werden dürfen. Höhere Werte brauchen
# deutlich mehr Arbeitsspeicher.
PDF_MAX_CONCURRENT="2"

# Optional: Pfad zu einem eigenen Chromium. Leer lassen, um den von Playwright
# installierten Browser zu verwenden (Standard im Docker-Image).
# PDF_CHROMIUM_PATH="/usr/bin/chromium"
